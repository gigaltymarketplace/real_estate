  <!-- Floating WhatsApp Concierge Button -->
  <a href="https://wa.me/919876543210?text=Hi%20Gigalty%2C%20I%20want%20to%20explore%20verified%20properties%20on%20gigalty.in%2Fbuy"
     target="_blank"
     rel="noopener noreferrer"
     class="floating-wa"
     data-track-contact="whatsapp"
     data-contact-location="floating_whatsapp_button"
     aria-label="Chat on WhatsApp with Gigalty">
    <span>💬 WhatsApp Gigalty</span>
  </a>

  <!-- =======================================================================
       PRODUCTION ANALYTICS (WINDOW.DATALAYER) & 3-STEP FORM CONTROLLER
       ======================================================================= -->
  <script>
    (function () {
      'use strict';

      const CFG = window.GIGALTY_CONFIG;
      window.dataLayer = window.dataLayer || [];

      function pushEvent(eventName, payload) {
        window.dataLayer.push(
          Object.assign(
            {
              event: eventName,
              timestamp: new Date().toISOString(),
              page_url: window.location.href
            },
            payload || {}
          )
        );
      }

      // 1. Page View Event
      pushEvent('page_view', {
        page_title: document.title,
        page_path: window.location.pathname || '/',
        destination_buy_url: CFG.BUY_URL
      });

      // 2. Mobile Navigation Toggle
      const mobileToggle = document.getElementById('mobileMenuToggle');
      const mobileDrawer = document.getElementById('mobileMenuDrawer');
      if (mobileToggle && mobileDrawer) {
        mobileToggle.addEventListener('click', function () {
          const isOpen = mobileDrawer.classList.toggle('open');
          mobileToggle.setAttribute('aria-expanded', String(isOpen));
          pushEvent('nav_click', {
            nav_target: isOpen ? 'mobile_menu_open' : 'mobile_menu_close'
          });
        });
      }

      // 3. Delegated Tracking for CTAs, Phone, Email, WhatsApp & Navigation
      document.addEventListener('click', function (e) {
        const ctaEl = e.target.closest('[data-track-cta]');
        if (ctaEl) {
          pushEvent('cta_click', {
            cta_location: ctaEl.getAttribute('data-cta-location') || 'page',
            cta_text: ctaEl.getAttribute('data-cta-text') || ctaEl.textContent.trim(),
            destination_url: ctaEl.getAttribute('href') || CFG.BUY_URL
          });
        }

        const contactEl = e.target.closest('[data-track-contact]');
        if (contactEl) {
          const type = contactEl.getAttribute('data-track-contact');
          const location = contactEl.getAttribute('data-contact-location') || 'page';
          const href = contactEl.getAttribute('href') || '';
          const eventMap = {
            phone: 'phone_click',
            email: 'email_click',
            whatsapp: 'whatsapp_click'
          };
          pushEvent(eventMap[type] || 'contact_click', {
            contact_type: type,
            contact_location: location,
            contact_target: href
          });
        }

        const navEl = e.target.closest('[data-track-nav]');
        if (navEl) {
          pushEvent('nav_click', {
            nav_target: navEl.getAttribute('data-track-nav'),
            nav_text: navEl.textContent.trim(),
            destination_hash: navEl.getAttribute('href') || ''
          });

          if (mobileDrawer && mobileDrawer.contains(navEl)) {
            mobileDrawer.classList.remove('open');
            if (mobileToggle) mobileToggle.setAttribute('aria-expanded', 'false');
          }
        }
      });

      // 4. Region Filter Tabs (All, India, Canada, US)
      const filterTabs = document.querySelectorAll('[data-region-filter]');
      const listingCards = document.querySelectorAll('#listingsGrid .listing-card');

      filterTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          const region = tab.getAttribute('data-region-filter');
          filterTabs.forEach(function (t) {
            const active = t === tab;
            t.classList.toggle('active', active);
            t.setAttribute('aria-selected', String(active));
          });

          let visibleCount = 0;
          listingCards.forEach(function (card) {
            const matches = region === 'All' || card.getAttribute('data-region') === region;
            card.classList.toggle('hidden', !matches);
            if (matches) visibleCount += 1;
          });

          pushEvent('region_filter', {
            selected_region: region,
            visible_listings: visibleCount
          });
        });
      });

      // 5. YouTube Showcase Interaction Tracking
      const ytWrap = document.getElementById('youtubeShowcaseWrap');
      if (ytWrap) {
        let hoverLogged = false;
        ytWrap.addEventListener('pointerenter', function () {
          if (hoverLogged) return;
          hoverLogged = true;
          pushEvent('video_interaction', {
            action: 'hover_showcase',
            video_id: 'Ak38rjlmmrM'
          });
        });

        window.addEventListener('blur', function () {
          if (document.activeElement && document.activeElement.closest('#youtubeShowcaseWrap')) {
            pushEvent('video_interaction', {
              action: 'play_focus',
              video_id: 'Ak38rjlmmrM'
            });
          }
        });
      }

      // 6. Advanced 3-Step Lead Capture Form + Optional Webhook POST
      const form = document.getElementById('gigaltyLeadForm');
      const steps = {
        1: document.getElementById('formStep1'),
        2: document.getElementById('formStep2'),
        3: document.getElementById('formStep3')
      };
      const progressHeader = document.getElementById('formProgressHeader');
      const progressTitle = document.getElementById('progressStepTitle');
      const progressPct = document.getElementById('progressStepPct');
      const progressFill = document.getElementById('progressFillBar');
      const thankYouPanel = document.getElementById('thankYouPanel');

      let activeStep = 1;
      let hasFormStarted = false;

      const stepMeta = {
        1: { label: 'Step 1 of 3 • Goal & Region', pct: '33%', width: '33.33%' },
        2: { label: 'Step 2 of 3 • Property Type, Budget & Timeline', pct: '66%', width: '66.66%' },
        3: { label: 'Step 3 of 3 • Contact Details & WhatsApp Alerts', pct: '100%', width: '100%' }
      };

      function goToStep(stepNumber) {
        activeStep = stepNumber;
        [1, 2, 3].forEach(function (num) {
          steps[num].classList.toggle('active', num === stepNumber);
        });
        progressTitle.textContent = stepMeta[stepNumber].label;
        progressPct.textContent = stepMeta[stepNumber].pct;
        progressFill.style.width = stepMeta[stepNumber].width;
      }

      function markFormStarted(triggerField) {
        if (!hasFormStarted) {
          hasFormStarted = true;
          pushEvent('form_start', {
            form_id: 'gigaltyLeadForm',
            first_field: triggerField || 'unknown',
            step_number: activeStep
          });
        }
      }

      form.addEventListener('focusin', function (e) {
        const target = e.target;
        if (!target || !target.name) return;
        markFormStarted(target.name);
        pushEvent('field_focus', {
          form_id: 'gigaltyLeadForm',
          field_name: target.name,
          step_number: Number(target.getAttribute('data-step')) || activeStep
        });
      });

      form.addEventListener('focusout', function (e) {
        const target = e.target;
        if (!target || !target.name) return;
        const filled =
          target.type === 'checkbox' || target.type === 'radio'
            ? Boolean(target.checked)
            : String(target.value || '').trim().length > 0;
        pushEvent('field_blur', {
          form_id: 'gigaltyLeadForm',
          field_name: target.name,
          step_number: Number(target.getAttribute('data-step')) || activeStep,
          is_filled: filled
        });
      });

      document.getElementById('nextToStep2').addEventListener('click', function () {
        markFormStarted('nextToStep2');
        const goal = form.querySelector('input[name="goal"]:checked')?.value || 'Buy';
        const region = form.querySelector('input[name="region"]:checked')?.value || 'India';

        pushEvent('form_step_complete', {
          form_id: 'gigaltyLeadForm',
          completed_step: 1,
          next_step: 2,
          goal: goal,
          region: region
        });
        goToStep(2);
      });

      document.getElementById('backToStep1').addEventListener('click', function () {
        goToStep(1);
      });

      document.getElementById('nextToStep3').addEventListener('click', function () {
        markFormStarted('nextToStep3');
        const propertyType = document.getElementById('property_type').value;
        const budgetRange = document.getElementById('budget_range').value;
        const timeline = document.getElementById('timeline').value;

        pushEvent('form_step_complete', {
          form_id: 'gigaltyLeadForm',
          completed_step: 2,
          next_step: 3,
          property_type: propertyType,
          budget_range: budgetRange,
          timeline: timeline
        });
        goToStep(3);
      });

      document.getElementById('backToStep2').addEventListener('click', function () {
        goToStep(2);
      });

      function setFieldValidation(inputEl, errorEl, isValid) {
        inputEl.classList.toggle('invalid', !isValid);
        errorEl.classList.toggle('show', !isValid);
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        markFormStarted('submitFormBtn');

        const nameInput = document.getElementById('full_name');
        const emailInput = document.getElementById('email');
        const phoneInput = document.getElementById('phone_number');
        const countryCodeInput = document.getElementById('country_code');
        const notesInput = document.getElementById('notes');
        const whatsappOptInInput = document.getElementById('whatsapp_opt_in');

        const errName = document.getElementById('error_full_name');
        const errEmail = document.getElementById('error_email');
        const errPhone = document.getElementById('error_phone_number');

        const fullName = nameInput.value.trim();
        const email = emailInput.value.trim();
        const rawPhone = phoneInput.value.trim();
        const digitsOnly = rawPhone.replace(/\D/g, '');
        const countryCode = countryCodeInput.value;
        const notes = notesInput.value.trim();
        const whatsappOptIn = whatsappOptInInput.checked;

        const isNameValid = fullName.length >= 2;
        const isEmailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        const isPhoneValid = digitsOnly.length >= 7 && digitsOnly.length <= 15;

        setFieldValidation(nameInput, errName, isNameValid);
        setFieldValidation(emailInput, errEmail, isEmailValid);
        setFieldValidation(phoneInput, errPhone, isPhoneValid);

        const invalidFields = [];
        if (!isNameValid) invalidFields.push('full_name');
        if (!isEmailValid) invalidFields.push('email');
        if (!isPhoneValid) invalidFields.push('phone_number');

        if (invalidFields.length > 0) {
          pushEvent('form_validation_error', {
            form_id: 'gigaltyLeadForm',
            step_number: 3,
            invalid_fields: invalidFields
          });
          return;
        }

        const goal = form.querySelector('input[name="goal"]:checked')?.value || 'Buy';
        const region = form.querySelector('input[name="region"]:checked')?.value || 'India';
        const propertyType = document.getElementById('property_type').value;
        const budgetRange = document.getElementById('budget_range').value;
        const timeline = document.getElementById('timeline').value;

        const leadData = {
          lead_id: 'GIG-' + Date.now().toString(36).toUpperCase(),
          form_id: 'gigaltyLeadForm',
          goal: goal,
          region: region,
          property_type: propertyType,
          budget_range: budgetRange,
          timeline: timeline,
          full_name: fullName,
          email: email,
          phone: countryCode + ' ' + rawPhone,
          whatsapp_opt_in: whatsappOptIn,
          notes: notes,
          destination_buy_url: CFG.BUY_URL
        };

        pushEvent('form_submit', leadData);
        pushEvent('generate_lead', {
          lead_id: leadData.lead_id,
          goal: goal,
          region: region,
          property_type: propertyType,
          budget_range: budgetRange,
          timeline: timeline,
          whatsapp_opt_in: whatsappOptIn
        });

        // Optional Google Apps Script Webhook POST
        if (CFG.GOOGLE_APPS_SCRIPT_WEBHOOK_URL) {
          try {
            fetch(CFG.GOOGLE_APPS_SCRIPT_WEBHOOK_URL, {
              method: 'POST',
              mode: 'no-cors',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(leadData)
            });
          } catch (err) {
            // Non-blocking background webhook dispatch
          }
        }

        document.getElementById('thankYouName').textContent = fullName;
        document.getElementById('thankYouDetails').textContent =
          'Your ' + goal.toLowerCase() + ' inquiry for ' + propertyType + ' in ' + region + ' (' + budgetRange + ', ' + timeline + ') has been registered.';

        form.style.display = 'none';
        progressHeader.style.display = 'none';
        thankYouPanel.classList.add('active');
      });

      document.getElementById('submitAnotherBtn').addEventListener('click', function () {
        form.reset();
        hasFormStarted = false;
        thankYouPanel.classList.remove('active');
        form.style.display = 'block';
        progressHeader.style.display = 'block';
        goToStep(1);
      });

      // 7. Scroll Depth Milestones (25%, 50%, 75%, 100%)
      const trackedScrollDepths = new Set();
      const scrollMilestones = [25, 50, 75, 100];

      function evaluateScrollDepth() {
        const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (scrollableHeight <= 0) return;
        const currentPercent = Math.min(100, Math.round((window.scrollY / scrollableHeight) * 100));

        scrollMilestones.forEach(function (milestone) {
          if (currentPercent >= milestone && !trackedScrollDepths.has(milestone)) {
            trackedScrollDepths.add(milestone);
            pushEvent('scroll_depth', {
              scroll_percent: milestone
            });
          }
        });
      }

      window.addEventListener('scroll', evaluateScrollDepth, { passive: true });
      evaluateScrollDepth();
    })();
  </script>
