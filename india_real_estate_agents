  <!-- Typography: Plus Jakarta Sans & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

  <style>
    /* =========================================================================
       DESIGN TOKENS & EDITORIAL PROP-TECH UI STYLESHEET
       ========================================================================= */
    :root {
      --navy-950: #060b19;
      --navy-900: #0b132b;
      --navy-800: #162242;
      --navy-700: #22325e;
      --copper-600: #b45309;
      --copper-500: #d97706;
      --copper-400: #f59e0b;
      --copper-50: #fffbeb;
      --emerald-600: #059669;
      --emerald-50: #ecfdf5;
      --whatsapp-green: #16a34a;
      --whatsapp-dark: #15803d;
      --bg-canvas: #f8fafc;
      --bg-surface: #ffffff;
      --bg-subtle: #f1f5f9;
      --text-primary: #0b132b;
      --text-secondary: #475569;
      --text-muted: #64748b;
      --border-light: #e2e8f0;
      --border-strong: #cbd5e1;
      --radius-sm: 10px;
      --radius-md: 16px;
      --radius-lg: 22px;
      --radius-xl: 28px;
      --shadow-xs: 0 1px 2px rgba(11, 19, 43, 0.05);
      --shadow-sm: 0 8px 24px -8px rgba(11, 19, 43, 0.09);
      --shadow-md: 0 20px 44px -16px rgba(11, 19, 43, 0.16);
      --shadow-lg: 0 28px 64px -20px rgba(11, 19, 43, 0.28);
      --transition: 220ms cubic-bezier(0.22, 1, 0.36, 1);
      --max-w: 1240px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      margin: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-canvas);
      color: var(--text-primary);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    h1, h2, h3, h4, .font-heading {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      letter-spacing: -0.025em;
      margin-top: 0;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, input, select, textarea {
      font-family: inherit;
    }

    img {
      display: block;
      max-width: 100%;
    }

    .container {
      width: 100%;
      max-width: var(--max-w);
      margin-left: auto;
      margin-right: auto;
      padding-left: 20px;
      padding-right: 20px;
    }

    @media (min-width: 640px) {
      .container {
        padding-left: 28px;
        padding-right: 28px;
      }
    }

    /* =========================================================================
       TOP CONCIERGE STRIP & STICKY HEADER
       ========================================================================= */
    .concierge-strip {
      background-color: var(--navy-950);
      color: #cbd5e1;
      font-size: 0.8125rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .concierge-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 9px 0;
    }

    .concierge-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #f8fafc;
      font-weight: 500;
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--copper-400);
      box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.25);
    }

    .concierge-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
    }

    .concierge-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: #cbd5e1;
      font-weight: 500;
      transition: color var(--transition);
    }

    .concierge-link:hover {
      color: var(--copper-400);
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background-color: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-light);
    }

    .nav-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 74px;
      gap: 16px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 11px;
    }

    .brand-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--navy-900) 0%, var(--navy-800) 60%, var(--copper-500) 160%);
      color: #ffffff;
      display: grid;
      place-items: center;
      box-shadow: var(--shadow-xs);
    }

    .brand-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800;
      font-size: 1.38rem;
      color: var(--navy-900);
      letter-spacing: -0.03em;
    }

    .brand-badge {
      display: none;
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 3px 9px;
      border-radius: 999px;
      background-color: var(--copper-50);
      color: var(--copper-600);
      border: 1px solid rgba(217, 119, 6, 0.28);
    }

    @media (min-width: 480px) {
      .brand-badge {
        display: inline-block;
      }
    }

    .nav-links {
      display: none;
      align-items: center;
      gap: 26px;
      font-size: 0.925rem;
      font-weight: 600;
      color: var(--text-secondary);
    }

    @media (min-width: 960px) {
      .nav-links {
        display: flex;
      }
    }

    .nav-links a {
      position: relative;
      padding: 6px 0;
      transition: color var(--transition);
    }

    .nav-links a:hover {
      color: var(--navy-900);
    }

    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: 0;
      width: 0;
      height: 2px;
      background-color: var(--copper-500);
      transition: width var(--transition);
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    .nav-cta-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .menu-toggle {
      display: inline-grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-light);
      background-color: var(--bg-surface);
      color: var(--navy-900);
      cursor: pointer;
    }

    @media (min-width: 960px) {
      .menu-toggle {
        display: none;
      }
    }

    .mobile-menu {
      display: none;
      flex-direction: column;
      gap: 4px;
      padding: 12px 20px 18px;
      background-color: var(--bg-surface);
      border-bottom: 1px solid var(--border-light);
    }

    .mobile-menu.open {
      display: flex;
    }

    .mobile-menu a {
      padding: 10px 12px;
      border-radius: var(--radius-sm);
      font-weight: 600;
      color: var(--text-primary);
    }

    .mobile-menu a:hover {
      background-color: var(--bg-subtle);
    }

    /* =========================================================================
       BUTTONS & BADGES
       ========================================================================= */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 13px 22px;
      border-radius: 12px;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      font-size: 0.925rem;
      line-height: 1.2;
      cursor: pointer;
      border: 1px solid transparent;
      transition: transform var(--transition), background-color var(--transition), border-color var(--transition), box-shadow var(--transition);
    }

    .btn:active {
      transform: translateY(1px);
    }

    .btn-primary {
      background-color: var(--navy-900);
      color: #ffffff;
      box-shadow: var(--shadow-sm);
    }

    .btn-primary:hover {
      background-color: var(--navy-800);
      transform: translateY(-1px);
    }

    .btn-copper {
      background: linear-gradient(135deg, var(--copper-500) 0%, var(--copper-600) 100%);
      color: #ffffff;
      box-shadow: 0 12px 26px -10px rgba(217, 119, 6, 0.6);
    }

    .btn-copper:hover {
      filter: brightness(1.06);
      transform: translateY(-1px);
    }

    .btn-secondary {
      background-color: var(--bg-surface);
      color: var(--navy-900);
      border-color: var(--border-strong);
    }

    .btn-secondary:hover {
      background-color: var(--bg-subtle);
      border-color: var(--navy-900);
    }

    .btn-light-outline {
      background-color: rgba(255, 255, 255, 0.08);
      color: #ffffff;
      border-color: rgba(255, 255, 255, 0.25);
    }

    .btn-light-outline:hover {
      background-color: rgba(255, 255, 255, 0.16);
      border-color: rgba(255, 255, 255, 0.45);
    }

    .btn-sm {
      padding: 10px 16px;
      font-size: 0.84rem;
      border-radius: 10px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      background-color: var(--copper-50);
      color: var(--copper-600);
      border: 1px solid rgba(217, 119, 6, 0.25);
    }

    /* =========================================================================
       HERO SECTION & 16:9 YOUTUBE SHOWCASE
       ========================================================================= */
    .hero {
      padding: 48px 0 64px;
      background:
        radial-gradient(circle at 12% 14%, rgba(217, 119, 6, 0.09) 0%, transparent 45%),
        radial-gradient(circle at 88% 20%, rgba(11, 19, 43, 0.07) 0%, transparent 48%),
        var(--bg-canvas);
      border-bottom: 1px solid var(--border-light);
    }

    @media (min-width: 1024px) {
      .hero {
        padding: 68px 0 80px;
      }
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 38px;
      align-items: center;
    }

    @media (min-width: 1024px) {
      .hero-grid {
        grid-template-columns: 1.06fr 0.94fr;
        gap: 48px;
      }
    }

    .hero-heading {
      margin: 18px 0;
      font-size: clamp(2.2rem, 4.3vw, 3.5rem);
      font-weight: 800;
      line-height: 1.09;
      color: var(--navy-900);
    }

    .hero-heading span {
      color: var(--copper-600);
    }

    .hero-lead {
      margin: 0 0 26px;
      font-size: 1.06rem;
      line-height: 1.68;
      color: var(--text-secondary);
      max-width: 580px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 18px;
    }

    .hero-direct-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 20px;
      margin-bottom: 32px;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--text-secondary);
    }

    .hero-direct-bar a {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 0;
      border-bottom: 1px dashed var(--border-strong);
      transition: color var(--transition), border-color var(--transition);
    }

    .hero-direct-bar a:hover {
      color: var(--copper-600);
      border-color: var(--copper-500);
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      padding-top: 24px;
      border-top: 1px solid var(--border-light);
    }

    @media (min-width: 560px) {
      .stats-row {
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
      }
    }

    .stat-card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      padding: 14px 16px;
      box-shadow: var(--shadow-xs);
    }

    .stat-num {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800;
      font-size: 1.3rem;
      color: var(--navy-900);
      line-height: 1.2;
    }

    .stat-num.accent {
      color: var(--copper-600);
    }

    .stat-text {
      margin-top: 4px;
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    /* YouTube Video Showcase Card */
    .video-card {
      background-color: var(--navy-900);
      color: #ffffff;
      border-radius: var(--radius-xl);
      padding: 18px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: var(--shadow-lg);
    }

    @media (min-width: 640px) {
      .video-card {
        padding: 22px;
      }
    }

    .video-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
      font-size: 0.8rem;
      color: #cbd5e1;
    }

    .video-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 11px;
      border-radius: 999px;
      background-color: rgba(245, 158, 11, 0.16);
      color: var(--copper-400);
      font-weight: 700;
      font-size: 0.72rem;
      border: 1px solid rgba(245, 158, 11, 0.32);
    }

    .video-frame-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: var(--radius-md);
      overflow: hidden;
      background-color: #000000;
      border: 1px solid rgba(255, 255, 255, 0.14);
    }

    .video-frame-wrap iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .video-card-bar {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 16px;
      padding-top: 14px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    @media (min-width: 560px) {
      .video-card-bar {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }
    }

    .video-bar-copy {
      font-size: 0.84rem;
      color: #cbd5e1;
      line-height: 1.45;
    }

    .video-bar-copy strong {
      display: block;
      color: #ffffff;
      font-size: 0.94rem;
      margin-bottom: 2px;
    }

    /* =========================================================================
       COMMON SECTION HEADINGS
       ========================================================================= */
    .section {
      padding: 68px 0;
    }

    @media (min-width: 1024px) {
      .section {
        padding: 84px 0;
      }
    }

    .section-head {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 36px;
    }

    @media (min-width: 768px) {
      .section-head.split {
        flex-direction: row;
        align-items: flex-end;
        justify-content: space-between;
      }
    }

    .section-title {
      margin: 10px 0 8px;
      font-size: clamp(1.75rem, 3.2vw, 2.45rem);
      font-weight: 800;
      color: var(--navy-900);
      line-height: 1.15;
    }

    .section-subtitle {
      margin: 0;
      font-size: 1rem;
      color: var(--text-secondary);
      max-width: 640px;
    }

    /* =========================================================================
       FEATURED LISTINGS & REGION TABS
       ========================================================================= */
    .filter-bar {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 6px;
      padding: 6px;
      background-color: var(--bg-surface);
      border: 1px solid var(--border-light);
      border-radius: 14px;
      box-shadow: var(--shadow-xs);
    }

    .filter-tab {
      padding: 9px 18px;
      border-radius: 10px;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all var(--transition);
    }

    .filter-tab:hover {
      color: var(--navy-900);
      background-color: var(--bg-subtle);
    }

    .filter-tab.active {
      background-color: var(--navy-900);
      color: #ffffff;
      box-shadow: var(--shadow-xs);
    }

    .listings-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
    }

    @media (min-width: 640px) {
      .listings-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1024px) {
      .listings-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .listing-card {
      background-color: var(--bg-surface);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-sm);
      transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
    }

    .listing-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--copper-500);
    }

    .listing-card.hidden {
      display: none;
    }

    .listing-thumb {
      position: relative;
      height: 210px;
      background-color: var(--bg-subtle);
      overflow: hidden;
    }

    .listing-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .listing-card:hover .listing-thumb img {
      transform: scale(1.04);
    }

    .thumb-tags {
      position: absolute;
      top: 12px;
      left: 12px;
      right: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .tag-tour {
      padding: 5px 10px;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 700;
      background-color: rgba(11, 19, 43, 0.88);
      color: #ffffff;
    }

    .tag-region {
      padding: 5px 10px;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 700;
      background-color: var(--copper-50);
      color: var(--copper-600);
      border: 1px solid rgba(217, 119, 6, 0.3);
    }

    .listing-body {
      padding: 20px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .listing-category {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--copper-600);
      margin-bottom: 6px;
    }

    .listing-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--navy-900);
      margin-bottom: 6px;
    }

    .listing-loc {
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-bottom: 14px;
    }

    .listing-specs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 16px;
    }

    .spec-chip {
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--text-secondary);
      background-color: var(--bg-subtle);
      padding: 4px 10px;
      border-radius: 8px;
    }

    .listing-price-row {
      margin-top: auto;
      padding-top: 14px;
      margin-bottom: 14px;
      border-top: 1px solid var(--border-light);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .listing-price {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800;
      font-size: 1.12rem;
      color: var(--navy-900);
    }

    .zero-fee-pill {
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--emerald-600);
      background-color: var(--emerald-50);
      padding: 3px 9px;
      border-radius: 999px;
    }

    .listing-actions {
      display: flex;
      gap: 8px;
    }

    .listing-actions .btn-primary {
      flex: 1;
    }

    .section-bottom-cta {
      margin-top: 34px;
      text-align: center;
    }

    /* =========================================================================
       HOW IT WORKS / WHY GIGALTY BANNER
       ========================================================================= */
    .navy-section {
      background-color: var(--navy-900);
      color: #ffffff;
    }

    .navy-section .section-title {
      color: #ffffff;
    }

    .navy-section .section-subtitle {
      color: #94a3b8;
    }

    .pillars-grid {
